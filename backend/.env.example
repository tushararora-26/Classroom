# Local development. On Vercel, set these in Project Settings -> Environment Variables
# (PORT is ignored there — Vercel assigns it).

PORT=3000

# MongoDB. Locally: mongodb://localhost:27017/classroom
# On Vercel you need a hosted database, e.g. MongoDB Atlas:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/classroom?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017/classroom

# Sign tokens with a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# The deployed frontend origin, used for CORS. No trailing slash.
FRONTEND_URL=http://localhost:5173

# Optional: extra comma-separated origins (custom domain, other previews).
# ALLOWED_ORIGINS=https://classroom.example.com,https://www.classroom.example.com
